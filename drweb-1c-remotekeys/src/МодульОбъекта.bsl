///////////////////////////////////////////////////////////////////////////////
// Модуль объекта внешней обработки "DrWebRemoteKeys".
//
// Клиент партнёрского интерфейса Dr.Web для автоматизации генерации лицензий
// (https://f2.drweb.com/remotekeys/ и https://gsi.drweb.com/register/getserialinfo/).
//
// Ядро не зависит от формы и от конфигурации: его можно использовать как из
// формы этой обработки, так и из любого серверного кода (например, скопировав в
// общий модуль). Все обращения к сети выполняются на сервере (тонкий/веб-клиент
// напрямую HTTPСоединение не создаёт).
//
// Основные экспортные методы:
//   НоваяНастройка(Логин, Пароль)        - параметры подключения;
//   НовыеПараметрыГенерации()            - шаблон параметров запроса на генерацию;
//   СгенерироватьСерийныеНомера()        - act=serial;
//   ЗаблокироватьСерийныйНомер()         - act=blockserial;
//   ПолучитьИнформациюПоСерийному()      - gsi.drweb.com/register/getserialinfo.
//
// Пароль партнёра нигде не логируется и не сохраняется этим модулем.
///////////////////////////////////////////////////////////////////////////////

#Область ПрограммныйИнтерфейс

// Возвращает структуру настроек подключения к интерфейсу Dr.Web.
//
// Параметры:
//   Логин  - Строка - логин партнёра (как на партнёрском портале Dr.Web).
//   Пароль - Строка - пароль партнёра.
//
// Возвращаемое значение:
//   Структура - настройки, поля которой можно скорректировать перед вызовом:
//     * Логин          - Строка;
//     * Пароль         - Строка;
//     * ХостГенерации  - Строка - по умолчанию "f2.drweb.com";
//     * ПутьГенерации  - Строка - по умолчанию "/remotekeys/";
//     * ХостИнфо       - Строка - по умолчанию "gsi.drweb.com";
//     * ПутьИнфо       - Строка - по умолчанию "/register/getserialinfo/";
//     * Таймаут        - Число  - таймаут соединения, секунд (по умолчанию 60);
//     * Прокси         - ИнтернетПрокси, Неопределено - прокси при необходимости;
//     * ФорматXML      - Булево - запрашивать ответ генерации в XML (format=xml);
//     * Тестовый       - Булево - тестовый режим генерации (testing=yes).
//
Функция НоваяНастройка(Логин = "", Пароль = "") Экспорт

	Настройка = Новый Структура;
	Настройка.Вставить("Логин", Логин);
	Настройка.Вставить("Пароль", Пароль);
	Настройка.Вставить("ХостГенерации", "f2.drweb.com");
	Настройка.Вставить("ПутьГенерации", "/remotekeys/");
	Настройка.Вставить("ХостИнфо", "gsi.drweb.com");
	Настройка.Вставить("ПутьИнфо", "/register/getserialinfo/");
	Настройка.Вставить("Таймаут", 60);
	Настройка.Вставить("Прокси", Неопределено);
	Настройка.Вставить("ФорматXML", Истина);
	Настройка.Вставить("Тестовый", Ложь);
	Возврат Настройка;

КонецФункции

// Возвращает шаблон параметров запроса на генерацию серийных номеров.
// Заполните нужные поля и передайте в СгенерироватьСерийныеНомера().
//
// Возвращаемое значение:
//   Структура:
//     * Продукт                    - Строка, Число - идентификатор продукта (product);
//     * Период                     - Строка - срок лицензии (period): "1m", "3m", "12m", "24m" и т.п.;
//     * Скидка                     - Строка, Число - идентификатор скидки (discount);
//     * Компьютеры                 - Число - рабочие станции (computers);
//     * Серверы                    - Число - серверы (servers);
//     * ПочтовыеЯщики              - Число - почтовые ящики (mailboxes);
//     * Трафик                     - Число - трафик (traffic); нельзя одновременно с ПочтовыеЯщики;
//     * Пользователи               - Число - пользователи (users);
//     * КомментарийЗаказа          - Строка - комментарий (comment);
//     * ИдентификаторПозицииЗаказа - Строка - order_item_id (идемпотентный ключ перезапроса);
//     * СерийныйДляПродления       - Строка - renewserial (продление существующей лицензии);
//     * БезАвтодоставки            - Булево - no_auto_delivery=yes (только домашние продукты);
//     * АнкетаКлиента              - Структура - поля бизнес-анкеты (см. НоваяАнкетаКлиента);
//     * ЦепочкаПоставки            - Структура - for_partner/for_partner_next/supplier (см. НоваяЦепочкаПоставки);
//     * ДополнительныеПараметры    - Соответствие - любые дополнительные параметры запроса (Имя -> Значение),
//                                    например "keytype". Имеют приоритет над остальными полями.
//
Функция НовыеПараметрыГенерации() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("Продукт");
	Параметры.Вставить("Период");
	Параметры.Вставить("Скидка");
	Параметры.Вставить("Компьютеры");
	Параметры.Вставить("Серверы");
	Параметры.Вставить("ПочтовыеЯщики");
	Параметры.Вставить("Трафик");
	Параметры.Вставить("Пользователи");
	Параметры.Вставить("КомментарийЗаказа");
	Параметры.Вставить("ИдентификаторПозицииЗаказа");
	Параметры.Вставить("СерийныйДляПродления");
	Параметры.Вставить("БезАвтодоставки", Ложь);
	Параметры.Вставить("АнкетаКлиента", НоваяАнкетаКлиента());
	Параметры.Вставить("ЦепочкаПоставки", НоваяЦепочкаПоставки());
	Параметры.Вставить("ДополнительныеПараметры", Новый Соответствие);
	Возврат Параметры;

КонецФункции

// Возвращает шаблон бизнес-анкеты пользователя (обязательна для продуктов для бизнеса).
// Ключи структуры совпадают с именами параметров запроса Dr.Web.
//
// Возвращаемое значение:
//   Структура - ui_cntry, ui_inn, ui_kpp, ui_orgname, ui_postindex, ui_postaddr,
//               ui_www, ui_cname, ui_cjob, ui_cphone, ui_cemail, ui_comment.
//               Обязательны ui_cntry (если страна клиента отличается от страны партнёра) и ui_inn.
//
Функция НоваяАнкетаКлиента() Экспорт

	Анкета = Новый Структура;
	Анкета.Вставить("ui_cntry");
	Анкета.Вставить("ui_inn");
	Анкета.Вставить("ui_kpp");
	Анкета.Вставить("ui_orgname");
	Анкета.Вставить("ui_postindex");
	Анкета.Вставить("ui_postaddr");
	Анкета.Вставить("ui_www");
	Анкета.Вставить("ui_cname");
	Анкета.Вставить("ui_cjob");
	Анкета.Вставить("ui_cphone");
	Анкета.Вставить("ui_cemail");
	Анкета.Вставить("ui_comment");
	Возврат Анкета;

КонецФункции

// Возвращает шаблон параметров цепочки поставки.
// Заполняется только при соответствующей роли партнёра (Поставщик/Посредник/Дилер).
//
// Возвращаемое значение:
//   Структура:
//     * for_partner      - Строка - ИНН/номер карточки/логин партнёра, для которого размещается заказ;
//     * for_partner_next - Строка - следующее звено цепочки после for_partner (только вместе с for_partner);
//     * supplier         - Строка - поставщик, через которого размещается заказ (при нескольких поставщиках).
//
Функция НоваяЦепочкаПоставки() Экспорт

	Цепочка = Новый Структура;
	Цепочка.Вставить("for_partner");
	Цепочка.Вставить("for_partner_next");
	Цепочка.Вставить("supplier");
	Возврат Цепочка;

КонецФункции

// Генерирует лицензионные серийные номера (act=serial).
//
// Параметры:
//   Настройка  - Структура - см. НоваяНастройка();
//   Параметры  - Структура - см. НовыеПараметрыГенерации().
//
// Возвращаемое значение:
//   Структура - результат (см. НовыйРезультат). При успехе серийные номера — в поле СерийныеНомера.
//
Функция СгенерироватьСерийныеНомера(Настройка, Параметры) Экспорт

	ЗапросныеПараметры = Новый Соответствие;
	ЗапросныеПараметры.Вставить("login", Настройка.Логин);
	ЗапросныеПараметры.Вставить("pwd", Настройка.Пароль);
	ЗапросныеПараметры.Вставить("act", "serial");

	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "product",       Опц(Параметры, "Продукт"));
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "period",        Опц(Параметры, "Период"));
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "discount",      Опц(Параметры, "Скидка"));
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "computers",     Опц(Параметры, "Компьютеры"));
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "servers",       Опц(Параметры, "Серверы"));
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "mailboxes",     Опц(Параметры, "ПочтовыеЯщики"));
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "traffic",       Опц(Параметры, "Трафик"));
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "users",         Опц(Параметры, "Пользователи"));
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "comment",       Опц(Параметры, "КомментарийЗаказа"));
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "order_item_id", Опц(Параметры, "ИдентификаторПозицииЗаказа"));
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "renewserial",   Опц(Параметры, "СерийныйДляПродления"));

	Если Опц(Параметры, "БезАвтодоставки") = Истина Тогда
		ЗапросныеПараметры.Вставить("no_auto_delivery", "yes");
	КонецЕсли;

	ДобавитьСтруктуруПараметров(ЗапросныеПараметры, Опц(Параметры, "АнкетаКлиента"));
	ДобавитьСтруктуруПараметров(ЗапросныеПараметры, Опц(Параметры, "ЦепочкаПоставки"));
	ДобавитьСоответствиеПараметров(ЗапросныеПараметры, Опц(Параметры, "ДополнительныеПараметры"));

	Если Настройка.ФорматXML Тогда
		ЗапросныеПараметры.Вставить("format", "xml");
	КонецЕсли;
	Если Настройка.Тестовый Тогда
		ЗапросныеПараметры.Вставить("testing", "yes");
	КонецЕсли;

	ТелоЗапроса = СобратьТелоФормы(ЗапросныеПараметры);
	Результат = ВыполнитьHTTP(Настройка, Настройка.ХостГенерации, Настройка.ПутьГенерации, "POST", ТелоЗапроса);

	Если Результат.КодHTTP = 200 Тогда
		Результат.Успех = Истина;
		Для Каждого Серийный Из НайтиСерийныеНомера(Результат.Тело) Цикл
			Результат.СерийныеНомера.Добавить(Серийный);
		КонецЦикла;
		Если СтрНайти(НРег(Результат.ТипКонтента), "xml") > 0 Тогда
			Результат.Атрибуты = РазобратьXMLВСоответствие(Результат.Тело);
		КонецЕсли;
	Иначе
		ЗаполнитьОшибку(Результат, "serial");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Блокирует серийный номер, по которому ещё не был получен ключ (act=blockserial).
//
// Параметры:
//   Настройка      - Структура - см. НоваяНастройка();
//   СерийныйНомер  - Строка    - серийный номер для блокировки;
//   Причина        - Строка    - причина блокировки (параметр reason).
//
// Возвращаемое значение:
//   Структура - результат (см. НовыйРезультат). При успехе КодHTTP = 200.
//
Функция ЗаблокироватьСерийныйНомер(Настройка, СерийныйНомер, Причина = "") Экспорт

	ЗапросныеПараметры = Новый Соответствие;
	ЗапросныеПараметры.Вставить("login", Настройка.Логин);
	ЗапросныеПараметры.Вставить("pwd", Настройка.Пароль);
	ЗапросныеПараметры.Вставить("act", "blockserial");
	ЗапросныеПараметры.Вставить("serial", СерийныйНомер);
	ВставитьЕслиЗаполнено(ЗапросныеПараметры, "reason", Причина);

	ТелоЗапроса = СобратьТелоФормы(ЗапросныеПараметры);
	Результат = ВыполнитьHTTP(Настройка, Настройка.ХостГенерации, Настройка.ПутьГенерации, "POST", ТелоЗапроса);

	Если Результат.КодHTTP = 200 Тогда
		Результат.Успех = Истина;
	Иначе
		ЗаполнитьОшибку(Результат, "blockserial");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает информацию по серийному номеру (gsi.drweb.com/register/getserialinfo).
// Авторизация не требуется.
//
// Параметры:
//   Настройка      - Структура - см. НоваяНастройка();
//   СерийныйНомер  - Строка    - серийный номер.
//
// Возвращаемое значение:
//   Структура - результат (см. НовыйРезультат). Разобранный XML <serialattrs> — в поле Атрибуты
//               (Соответствие: period, pid, dcode, valid, blocked, registered, type, renew, renewed,
//               created, expires, expired, drwebes, fromupdater и т.д. — набор полей может отличаться).
//
Функция ПолучитьИнформациюПоСерийному(Настройка, СерийныйНомер) Экспорт

	Путь = Настройка.ПутьИнфо + "?serial=" + КодироватьЗначение(СерийныйНомер);
	Результат = ВыполнитьHTTP(Настройка, Настройка.ХостИнфо, Путь, "GET", "");

	Если Результат.КодHTTP = 200 Тогда
		Результат.Успех = Истина;
		Результат.Атрибуты = РазобратьXMLВСоответствие(Результат.Тело);
	Иначе
		ЗаполнитьОшибку(Результат, "info");
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает пустую структуру результата запроса к интерфейсу Dr.Web.
//
// Возвращаемое значение:
//   Структура:
//     * Успех          - Булево - запрос выполнен успешно (КодHTTP = 200);
//     * КодHTTP        - Число  - код состояния HTTP-ответа;
//     * ТипКонтента    - Строка - значение заголовка Content-Type;
//     * Тело           - Строка - тело ответа как строка;
//     * Заголовки      - Соответствие - заголовки ответа;
//     * СерийныеНомера - Массив из Строка - распознанные серийные номера;
//     * Атрибуты       - Соответствие - разобранные из XML поля;
//     * КодОшибки      - Число  - код ошибки (совпадает с КодHTTP при ошибке; -1 при сбое соединения);
//     * ОписаниеОшибки - Строка - человекочитаемое описание ошибки.
//
Функция НовыйРезультат() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("КодHTTP", 0);
	Результат.Вставить("ТипКонтента", "");
	Результат.Вставить("Тело", "");
	Результат.Вставить("Заголовки", Новый Соответствие);
	Результат.Вставить("СерийныеНомера", Новый Массив);
	Результат.Вставить("Атрибуты", Новый Соответствие);
	Результат.Вставить("КодОшибки", 0);
	Результат.Вставить("ОписаниеОшибки", "");
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет HTTP-запрос к интерфейсу Dr.Web и заполняет базовые поля результата.
Функция ВыполнитьHTTP(Настройка, Хост, Путь, Метод, ТелоЗапроса)

	Результат = НовыйРезультат();

	Попытка
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
		Соединение = Новый HTTPСоединение(Хост, 443, , , Настройка.Прокси, Настройка.Таймаут, ЗащищенноеСоединение);
		Запрос = Новый HTTPЗапрос(Путь);

		Если ВРег(Метод) = "POST" Тогда
			Запрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");
			Запрос.УстановитьТелоИзСтроки(ТелоЗапроса, КодировкаТекста.UTF8);
			Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		Иначе
			Ответ = Соединение.Получить(Запрос);
		КонецЕсли;
	Исключение
		Результат.Успех = Ложь;
		Результат.КодОшибки = -1;
		Результат.ОписаниеОшибки = "Ошибка соединения с " + Хост + ": "
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;

	Результат.КодHTTP = Ответ.КодСостояния;
	Результат.Тело = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Для Каждого КлючЗначение Из Ответ.Заголовки Цикл
		Результат.Заголовки.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Результат.ТипКонтента = ПолучитьЗаголовокБезРегистра(Ответ.Заголовки, "Content-Type");

	Возврат Результат;

КонецФункции

// Заполняет поля ошибки результата на основании кода HTTP и действия.
Процедура ЗаполнитьОшибку(Результат, Действие)

	Результат.Успех = Ложь;
	Результат.КодОшибки = Результат.КодHTTP;
	Описание = ОписаниеКодаОшибки(Действие, Результат.КодHTTP);

	ТелоКратко = СокрЛП(Результат.Тело);
	Если ЗначениеЗаполнено(ТелоКратко) Тогда
		Описание = Описание + " | Ответ сервера: " + Лев(ТелоКратко, 300);
	КонецЕсли;
	Результат.ОписаниеОшибки = Описание;

КонецПроцедуры

// Возвращает значение свойства структуры или Неопределено, если свойства нет.
Функция Опц(Структура, Ключ)

	Значение = Неопределено;
	Если ТипЗнч(Структура) = Тип("Структура") Тогда
		Структура.Свойство(Ключ, Значение);
	КонецЕсли;
	Возврат Значение;

КонецФункции

// Вставляет параметр в соответствие, только если значение заполнено.
Процедура ВставитьЕслиЗаполнено(Параметры, Имя, Значение)

	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Число") И Значение = 0 Тогда
		Возврат;
	КонецЕсли;
	Параметры.Вставить(Имя, Значение);

КонецПроцедуры

// Добавляет непустые поля структуры (ключ структуры = имя параметра запроса).
Процедура ДобавитьСтруктуруПараметров(Параметры, Структура)

	Если ТипЗнч(Структура) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючЗначение Из Структура Цикл
		ВставитьЕслиЗаполнено(Параметры, КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

// Добавляет непустые элементы соответствия (ключ = имя параметра запроса).
Процедура ДобавитьСоответствиеПараметров(Параметры, ИсходноеСоответствие)

	Если ТипЗнч(ИсходноеСоответствие) <> Тип("Соответствие") Тогда
		Возврат;
	КонецЕсли;
	Для Каждого КлючЗначение Из ИсходноеСоответствие Цикл
		ВставитьЕслиЗаполнено(Параметры, СокрЛП(КлючЗначение.Ключ), КлючЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

// Собирает тело запроса application/x-www-form-urlencoded из соответствия параметров.
Функция СобратьТелоФормы(Параметры)

	Части = Новый Массив;
	Для Каждого КлючЗначение Из Параметры Цикл
		Если КлючЗначение.Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Части.Добавить(КодироватьЗначение(КлючЗначение.Ключ) + "=" + КодироватьЗначение(Строка(КлючЗначение.Значение)));
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");

КонецФункции

// URL-кодирование значения параметра.
//
// ВНИМАНИЕ (точка проверки при сборке): имя члена перечисления в вашей версии
// платформы может отличаться. Если Конфигуратор подчёркивает эту строку,
// проверьте доступный вариант СпособКодированияСтроки (URLВКодировке).
Функция КодироватьЗначение(Значение)

	Возврат КодироватьСтроку(Строка(Значение), СпособКодированияСтроки.URLВКодировке);

КонецФункции

// Регистронезависимо возвращает значение заголовка ответа.
Функция ПолучитьЗаголовокБезРегистра(Заголовки, Имя)

	ИмяНиж = НРег(Имя);
	Для Каждого КлючЗначение Из Заголовки Цикл
		Если НРег(КлючЗначение.Ключ) = ИмяНиж Тогда
			Возврат КлючЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Находит все серийные номера в тексте (формат XXXX-XXXX-XXXX-XXXX).
// Работает и для MIME-ответа (номер на отдельной строке), и для XML
// (номер внутри тега), за счёт скользящего окна с проверкой границ.
Функция НайтиСерийныеНомера(Текст)

	Результат = Новый Массив;
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат Результат;
	КонецЕсли;

	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция + 18 <= Длина Цикл
		Окно = Сред(Текст, Позиция, 19);
		Если ЭтоСерийныйНомер(Окно) Тогда
			СимволСлева  = ?(Позиция = 1, "", Сред(Текст, Позиция - 1, 1));
			СимволСправа = ?(Позиция + 19 > Длина, "", Сред(Текст, Позиция + 19, 1));
			ГраницаЛевоОК  = (НЕ ЭтоБукваЦифра(СимволСлева)) И СимволСлева <> "-";
			ГраницаПравоОК = (НЕ ЭтоБукваЦифра(СимволСправа)) И СимволСправа <> "-";
			Если ГраницаЛевоОК И ГраницаПравоОК Тогда
				Если Результат.Найти(Окно) = Неопределено Тогда
					Результат.Добавить(Окно);
				КонецЕсли;
				Позиция = Позиция + 19;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Проверяет, что строка имеет формат серийного номера XXXX-XXXX-XXXX-XXXX.
Функция ЭтоСерийныйНомер(Значение)

	Если СтрДлина(Значение) <> 19 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По 19 Цикл
		Символ = Сред(Значение, Позиция, 1);
		Если Позиция = 5 ИЛИ Позиция = 10 ИЛИ Позиция = 15 Тогда
			Если Символ <> "-" Тогда
				Возврат Ложь;
			КонецЕсли;
		Иначе
			Если НЕ ЭтоБукваЦифра(Символ) Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Проверяет, что символ — латинская буква или цифра.
Функция ЭтоБукваЦифра(Символ)

	Если СтрДлина(Символ) <> 1 Тогда
		Возврат Ложь;
	КонецЕсли;
	Набор = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
	Возврат СтрНайти(Набор, Символ) > 0;

КонецФункции

// Разбирает плоский XML в соответствие "имя тега -> значение".
// Устойчив к отсутствующим полям и к неполному/некорректному XML.
Функция РазобратьXMLВСоответствие(XMLТекст)

	Результат = Новый Соответствие;
	Если НЕ ЗначениеЗаполнено(XMLТекст) Тогда
		Возврат Результат;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(XMLТекст);
		ТекущийТег = "";
		Пока Чтение.Прочитать() Цикл
			Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				ТекущийТег = Чтение.Имя;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				Значение = СокрЛП(Чтение.Значение);
				Если ЗначениеЗаполнено(ТекущийТег) И ЗначениеЗаполнено(Значение) Тогда
					Результат.Вставить(ТекущийТег, Значение);
				КонецЕсли;
			ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				ТекущийТег = "";
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		// Возвращаем то, что удалось разобрать до ошибки.
	КонецПопытки;

	Возврат Результат;

КонецФункции

// Возвращает человекочитаемое описание кода ошибки с учётом действия.
// Действие: "serial" (генерация), "blockserial" (блокировка), "info" (getserialinfo).
Функция ОписаниеКодаОшибки(Действие, Код)

	Коды = Новый Соответствие;

	// Общие для генерации и блокировки.
	Коды.Вставить(403, "Отказано в доступе (ошибка авторизации дилера)");
	Коды.Вставить(405, "Поддерживается только метод POST");

	Если Действие = "serial" Тогда
		Коды.Вставить(412, "Недопустимое с точки зрения лицензирования сочетание продукта, скидки, срока, количества объектов");
		Коды.Вставить(503, "Сервис временно заблокирован, попробуйте ещё раз");
		Коды.Вставить(590, "Неверный или отсутствующий параметр product");
		Коды.Вставить(592, "Отсутствуют (не переданы или не валидны) данные о пользователе (бизнес-анкета)");
		Коды.Вставить(594, "Неверный или отсутствующий параметр computers");
		Коды.Вставить(595, "Неверный или отсутствующий параметр mailboxes");
		Коды.Вставить(596, "Неверный или отсутствующий параметр amount");
		Коды.Вставить(598, "Неверный параметр discount");
		Коды.Вставить(600, "Неверный или отсутствующий параметр traffic");
		Коды.Вставить(601, "Нельзя одновременно задавать параметры traffic и mailboxes");
		Коды.Вставить(603, "Неверный параметр Server ID (ключа с таким Server ID нет)");
		Коды.Вставить(614, "Указан неверный ключ (серийный номер)");
		Коды.Вставить(615, "Лицензия заблокирована");
		Коды.Вставить(616, "Несовместимые продукты при продлении");
		Коды.Вставить(617, "Неверный период для продления");
		Коды.Вставить(618, "Неверный период для продления");
		Коды.Вставить(619, "Несовместимые количества защищаемых объектов при продлении");
		Коды.Вставить(620, "Указан неверный ключ (серийный номер)");
		Коды.Вставить(625, "Уже продлён");
		Коды.Вставить(626, "Не продлеваемый продукт");
		Коды.Вставить(628, "Несовпадение количества объектов при продлении (превышает в новой лицензии)");
		Коды.Вставить(629, "Ошибка входа в эксклюзивный режим для переданного order_item_id");
		Коды.Вставить(630, "Неверная цепочка поставки (for_partner_next): отсутствует связь или доступ");
		Коды.Вставить(633, "Продлевается результат разбивки");
		Коды.Вставить(634, "Попытка продлить неактивированную лицензию");
	ИначеЕсли Действие = "blockserial" Тогда
		Коды.Вставить(401, "Серийный номер уже зарегистрирован (следует блокировать ключ, а не серийный номер)");
		Коды.Вставить(404, "Ключ не найден");
		Коды.Вставить(412, "Не указана причина блокировки (см. сообщение в status_line)");
		Коды.Вставить(591, "Не передан параметр key (нет идентификатора ключа)");
		Коды.Вставить(624, "Блокировка лицензии партнёром после истечения отчётного периода");
	КонецЕсли;

	Описание = Коды.Получить(Код);
	Если Описание = Неопределено Тогда
		Возврат СтрШаблон("Ошибка (HTTP %1)", Код);
	КонецЕсли;
	Возврат Описание;

КонецФункции

#КонецОбласти
