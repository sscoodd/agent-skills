///////////////////////////////////////////////////////////////////////////////
// Модуль основной формы внешней обработки "DrWebRemoteKeys".
//
// Тонкая надстройка над модулем объекта: собирает значения реквизитов формы,
// вызывает клиент API на сервере и выводит результат. Сетевые вызовы выполняются
// на сервере через объект обработки (РеквизитФормыВЗначение("Объект")).
//
// Пароль партнёра не выводится в результат и не логируется.
//
// Список реквизитов и элементов формы — в docs/СборкаОбработки.md.
///////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если НЕ ЗначениеЗаполнено(ФорматXML) Тогда
		ФорматXML = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сгенерировать(Команда)

	Если НЕ ЗначениеЗаполнено(Логин) ИЛИ НЕ ЗначениеЗаполнено(Пароль) Тогда
		ПоказатьПредупреждение(, "Укажите логин и пароль партнёра Dr.Web.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Продукт) ИЛИ НЕ ЗначениеЗаполнено(Период) Тогда
		ПоказатьПредупреждение(, "Укажите продукт и период лицензии.");
		Возврат;
	КонецЕсли;

	СгенерироватьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура Заблокировать(Команда)

	Если НЕ ЗначениеЗаполнено(Логин) ИЛИ НЕ ЗначениеЗаполнено(Пароль) Тогда
		ПоказатьПредупреждение(, "Укажите логин и пароль партнёра Dr.Web.");
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(СерийныйДляБлокировки) Тогда
		ПоказатьПредупреждение(, "Укажите серийный номер для блокировки.");
		Возврат;
	КонецЕсли;

	ЗаблокироватьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьИнформацию(Команда)

	Если НЕ ЗначениеЗаполнено(СерийныйДляИнформации) Тогда
		ПоказатьПредупреждение(, "Укажите серийный номер для запроса информации.");
		Возврат;
	КонецЕсли;

	ПолучитьИнформациюНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедуры

&НаСервере
Процедура СгенерироватьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");

	Настройка = Обработка.НоваяНастройка(Логин, Пароль);
	Настройка.Тестовый = Тестовый;
	Настройка.ФорматXML = ФорматXML;

	Параметры = Обработка.НовыеПараметрыГенерации();
	Параметры.Продукт = Продукт;
	Параметры.Период = Период;
	Параметры.Скидка = Скидка;
	Параметры.Компьютеры = Компьютеры;
	Параметры.Серверы = Серверы;
	Параметры.ПочтовыеЯщики = ПочтовыеЯщики;
	Параметры.Трафик = Трафик;
	Параметры.Пользователи = Пользователи;
	Параметры.КомментарийЗаказа = КомментарийЗаказа;
	Параметры.ИдентификаторПозицииЗаказа = ИдентификаторПозицииЗаказа;
	Параметры.СерийныйДляПродления = СерийныйДляПродления;
	ЗаполнитьДополнительныеПараметры(Параметры.ДополнительныеПараметры);

	Результат = Обработка.СгенерироватьСерийныеНомера(Настройка, Параметры);
	ВывестиРезультат(Результат, "Генерация серийных номеров");

КонецПроцедуры

&НаСервере
Процедура ЗаблокироватьНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Настройка = Обработка.НоваяНастройка(Логин, Пароль);

	Результат = Обработка.ЗаблокироватьСерийныйНомер(Настройка, СокрЛП(СерийныйДляБлокировки), СокрЛП(ПричинаБлокировки));
	ВывестиРезультат(Результат, "Блокировка серийного номера");

КонецПроцедуры

&НаСервере
Процедура ПолучитьИнформациюНаСервере()

	Обработка = РеквизитФормыВЗначение("Объект");
	Настройка = Обработка.НоваяНастройка(Логин, Пароль);

	Результат = Обработка.ПолучитьИнформациюПоСерийному(Настройка, СокрЛП(СерийныйДляИнформации));
	ВывестиРезультат(Результат, "Информация по серийному номеру");

КонецПроцедуры

// Переносит непустые строки таблицы формы в соответствие параметров запроса.
&НаСервере
Процедура ЗаполнитьДополнительныеПараметры(ЦелевоеСоответствие)

	Для Каждого СтрокаТаблицы Из ДополнительныеПараметры Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.Имя) Тогда
			ЦелевоеСоответствие.Вставить(СокрЛП(СтрокаТаблицы.Имя), СтрокаТаблицы.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Формирует человекочитаемый текст результата (без пароля) и выводит в реквизит формы.
&НаСервере
Процедура ВывестиРезультат(Результат, Заголовок)

	ПС = Символы.ПС;
	Текст = Заголовок + ПС;
	Текст = Текст + "HTTP: " + Формат(Результат.КодHTTP, "ЧГ=0") + ПС;

	Если Результат.Успех Тогда
		Если Результат.СерийныеНомера.Количество() > 0 Тогда
			Текст = Текст + "Серийные номера (" + Результат.СерийныеНомера.Количество() + "):" + ПС;
			Для Каждого Серийный Из Результат.СерийныеНомера Цикл
				Текст = Текст + "  " + Серийный + ПС;
			КонецЦикла;
		КонецЕсли;
		Если Результат.Атрибуты.Количество() > 0 Тогда
			Текст = Текст + "Атрибуты:" + ПС;
			Для Каждого КлючЗначение Из Результат.Атрибуты Цикл
				Текст = Текст + "  " + КлючЗначение.Ключ + " = " + КлючЗначение.Значение + ПС;
			КонецЦикла;
		КонецЕсли;
		Если Результат.СерийныеНомера.Количество() = 0 И Результат.Атрибуты.Количество() = 0 Тогда
			Текст = Текст + "Запрос выполнен успешно." + ПС;
		КонецЕсли;
	Иначе
		Текст = Текст + "ОШИБКА " + Формат(Результат.КодОшибки, "ЧГ=0") + ": " + Результат.ОписаниеОшибки + ПС;
	КонецЕсли;

	Текст = Текст + "----- Тело ответа -----" + ПС + Результат.Тело;
	РезультатТекст = Текст;

КонецПроцедуры

#КонецОбласти
